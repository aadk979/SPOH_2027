# SPOH 2027 client configuration.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time, so
# nothing secret belongs here. Copy to client/.env.local for local development.

NEXT_PUBLIC_API_BASE_URL=http://localhost:4010
NEXT_PUBLIC_ENV_LABEL=development

# Left blank while the server runs the development auth provider. Filling these
# in switches the sign-in screen to the Cognito hosted flow.
NEXT_PUBLIC_COGNITO_REGION=ap-southeast-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
