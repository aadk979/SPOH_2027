{
  "name": "@spoh/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Single definition of every DTO shared by the SPOH 2027 server and client.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generated/actions": {
      "types": "./dist/generated/actions/index.d.ts",
      "default": "./dist/generated/actions/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "date-fns": "^4.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
