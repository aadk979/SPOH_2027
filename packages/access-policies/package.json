{
  "name": "@spoh/access-policies",
  "version": "0.1.0",
  "private": true,
  "description": "Approved Cedar schema, policies and generated SPOH action catalogue.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./policy-set": {
      "types": "./dist/policySet.d.ts",
      "default": "./dist/policySet.js"
    },
    "./default-grants": {
      "types": "./dist/defaultGrants.d.ts",
      "default": "./dist/defaultGrants.js"
    },
    "./schema.cedarschema": "./schema.cedarschema",
    "./policies/*": "./policies/*",
    "./default-grants.json": "./default-grants.json"
  },
  "scripts": {
    "generate": "node tools/generate-grants.mjs && node tools/generate-actions.mjs && node tools/generate-avp.mjs",
    "check:generated": "node tools/generate-grants.mjs --check && node tools/generate-actions.mjs --check && node tools/generate-avp.mjs --check",
    "build": "npm run check:generated && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:unit": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "4.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "prettier": "^3.9.9",
    "typescript": "6.0.3"
  }
}
