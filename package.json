{
  "name": "spoh2027",
  "private": true,
  "version": "0.1.0",
  "description": "SPOH 2027 Event Operations System — Singapore Polytechnic School of Computing Open House",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22 <27"
  },
  "workspaces": [
    "packages/*",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run build:shared && run-p dev:shared dev:server dev:client",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace packages/shared && npm run build --workspace server && npm run build --workspace client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace server",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:reset": "npm run db:reset --workspace server",
    "audit:ci": "npm audit --audit-level=high",
    "build:shared": "npm run build --workspace packages/shared",
    "dev:shared": "npm run dev --workspace packages/shared"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
