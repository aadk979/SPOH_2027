# SPOH 2027 server configuration.
#
# Copy to `server/.env` for local development. NEVER commit a real `.env`.
# Staging and production inject these from AWS Secrets Manager / SSM Parameter
# Store (BUILD_PLAN §8.6). Every key below is validated by src/config/env.ts at
# boot; the server refuses to start on a missing or malformed value.

NODE_ENV=development
PORT=4010
LOG_LEVEL=debug

# ── Database ────────────────────────────────────────────────────────────────
# Production must use sslmode=require.
DATABASE_URL=postgresql://spoh:spoh@localhost:5435/spoh2027

# ── Authentication ──────────────────────────────────────────────────────────
# `cognito` is the only permitted value outside development. `local` issues and
# verifies HS256 dev tokens so the whole system is runnable before the Cognito
# User Pool exists; src/config/env.ts hard-refuses it when NODE_ENV=production.
AUTH_PROVIDER=local

# Required when AUTH_PROVIDER=local. Any string >= 32 chars. Dev only.
LOCAL_AUTH_SECRET=dev-only-secret-change-me-at-least-32-chars

# Required when AUTH_PROVIDER=cognito. The staging pool is already provisioned
# in ap-southeast-1 — these are public client identifiers, not secrets, and they
# ship in the browser bundle either way. See docs/DEPLOYMENT.md.
COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=ap-southeast-1_9bwl2nGF7
COGNITO_CLIENT_ID=23uft7mvtnrno1uunsc5lp0h2v

# Hosted UI base and this deployment's own public origin. Used to build the
# OAuth redirect_uri for GET /api/v1/auth/login and /callback. Required when
# AUTH_PROVIDER=cognito.
COGNITO_DOMAIN=
APP_BASE_URL=

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma separated, exact origins, no wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Rate limiting ───────────────────────────────────────────────────────────
# Capture endpoints get a far higher ceiling on purpose: a booth volunteer at
# peak genuinely taps fast, and throttling them corrupts the data.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_DEFAULT=300
RATE_LIMIT_MAX_CAPTURE=1200
RATE_LIMIT_MAX_SENSITIVE=20
# Administration writes — volunteers, stations, event days, settings. Bursty and
# human-paced: configuring a dry run is one sitting, not an attack.
RATE_LIMIT_MAX_ADMIN=60

# ── Database pool ───────────────────────────────────────────────────────────
# Peak is roughly 80 concurrent volunteers; 5 turns that into a queue.
DATABASE_POOL_MAX=25

# ── Trust proxy ─────────────────────────────────────────────────────────────
# Number of proxy hops in front of the app (App Runner / ALB = 1). 0 disables.
TRUST_PROXY_HOPS=0

# ── S3 media archive (phase 3) ──────────────────────────────────────────────
S3_MEDIA_BUCKET=
AWS_REGION=ap-southeast-1

# ── Development convenience ─────────────────────────────────────────────────
# Treat every hour as event hours, so the capture screens work outside
# 09:30-18:00 Singapore. Refused when NODE_ENV=production.
SHIFT_HOURS_ALWAYS_OPEN=true
# Attendance: seed this account as ADMIN and use it as the event-day trust root.
# Set ATTENDANCE_ROOT_EMAIL before seeding. Production also needs SEED_ADMIN_SUB.
# ATTENDANCE_ROOT_EMAIL=event-root@example.com
# Optional dedicated key; defaults to a key derived from SESSION_SIGNING_SECRET.
# ATTENDANCE_SIGNING_SECRET=replace-with-a-random-secret-at-least-32-characters
# Campus PUBLIC egress CIDRs from SP IT, comma-separated (IPv4 and/or IPv6).
# Empty means QR network verification fails closed; secondary PIN remains usable.
ATTENDANCE_SP_CIDRS=
# TRUST_PROXY_HOPS must match your actual trusted reverse-proxy topology.
