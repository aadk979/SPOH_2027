# SPOH 2027 server configuration.
#
# Copy to `server/.env` for local development. NEVER commit a real `.env`.
# Staging and production inject these from AWS Secrets Manager / SSM Parameter
# Store (BUILD_PLAN §8.6). Every key below is validated by src/config/schema.ts
# at boot; the server refuses to start on a missing or malformed value.
#
# Every key the server reads is listed here (tests/unit/config.test.ts checks
# it). Each is marked:
#   [required]                  no default; the server will not start without it
#   [required in production]    optional in development, refused if absent in production
#   [required when …]           required only in the stated configuration
#   [optional, default …]       omit to take the default
#   [optional]                  omit to switch the feature off
# A key shown commented out (`# KEY=`) is optional and off in this example.

# [optional, default development] development | test | production
NODE_ENV=development
# [optional, default 4000]
PORT=4010
# [optional, default info] fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# ── Database ────────────────────────────────────────────────────────────────
# [required] Production must use sslmode=require.
DATABASE_URL=postgresql://spoh:spoh@localhost:5435/spoh2027
# [optional, default 25] Peak is roughly 80 concurrent volunteers; 5 turns that
# into a queue.
DATABASE_POOL_MAX=25

# ── Authentication ──────────────────────────────────────────────────────────
# [optional, default cognito] `cognito` is the only permitted value outside
# development. `local` issues and verifies HS256 dev tokens so the whole system
# is runnable before the Cognito User Pool exists; the server hard-refuses it
# when NODE_ENV=production.
AUTH_PROVIDER=local

# [required when AUTH_PROVIDER=local] Any string >= 32 chars. Dev only.
LOCAL_AUTH_SECRET=dev-only-secret-change-me-at-least-32-chars

# [required when AUTH_PROVIDER=cognito, except COGNITO_REGION: optional,
# default ap-southeast-1] The staging pool is already provisioned in
# ap-southeast-1 — these are public client identifiers, not secrets, and they
# ship in the browser bundle either way. See docs/DEPLOYMENT.md.
COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=ap-southeast-1_9bwl2nGF7
COGNITO_CLIENT_ID=23uft7mvtnrno1uunsc5lp0h2v

# [required when AUTH_PROVIDER=cognito] Hosted UI base and this deployment's
# own public origin. Used to build the OAuth redirect_uri for
# GET /api/v1/auth/login and /callback.
COGNITO_DOMAIN=
APP_BASE_URL=

# ── Sessions ────────────────────────────────────────────────────────────────
# [required in production] Signing key for the API's own access tokens, >= 32
# chars. Unset in development: a key is generated at boot, so every restart
# signs everyone out.
# SESSION_SIGNING_SECRET=replace-with-a-random-secret-at-least-32-characters
# [optional, default 900] Access-token lifetime in seconds, 60 to 86400. Short,
# because the refresh cookie renews it.
ACCESS_TOKEN_TTL_SECONDS=900
# [optional] Domain for the refresh cookie. Leave unset for a host-only cookie.
# SESSION_COOKIE_DOMAIN=
# [optional, default false] Send the refresh cookie cross-site, for a client
# served from another origin than the API. Needs https origins in production.
SESSION_COOKIE_CROSS_SITE=false

# ── CORS ────────────────────────────────────────────────────────────────────
# [optional, default http://localhost:3000] Comma separated, exact origins, no
# wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Rate limiting ───────────────────────────────────────────────────────────
# [optional, defaults as shown] Capture endpoints get a far higher ceiling on
# purpose: a booth volunteer at peak genuinely taps fast, and throttling them
# corrupts the data.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_DEFAULT=300
RATE_LIMIT_MAX_CAPTURE=1200
RATE_LIMIT_MAX_SENSITIVE=20
# Administration writes — volunteers, stations, event days, settings. Bursty and
# human-paced: configuring a dry run is one sitting, not an attack.
RATE_LIMIT_MAX_ADMIN=60

# ── Trust proxy ─────────────────────────────────────────────────────────────
# [optional, default 0] Number of proxy hops in front of the app
# (App Runner / ALB = 1). 0 disables. Must match the actual trusted
# reverse-proxy topology.
TRUST_PROXY_HOPS=0

# [optional] The client's static export (`SPOH_STATIC_EXPORT=1 next build` →
# client/out), served by this process on the API's own origin (ADR-008 §2).
# Unset in development, where Next serves the client on its own port.
# CLIENT_DIR=../client/out

# ── S3 media archive ────────────────────────────────────────────────────────
# [optional] Unset switches photo uploads off (they answer MEDIA_NOT_CONFIGURED).
S3_MEDIA_BUCKET=
# [optional, default ap-southeast-1]
AWS_REGION=ap-southeast-1
# [optional, default 300] Seconds a presigned upload policy stays valid, 30 to 3600.
S3_UPLOAD_TTL_SECONDS=300
# [optional, default 10485760] Upload ceiling in bytes, written into the policy
# so S3 enforces it too.
S3_MAX_UPLOAD_BYTES=10485760

# ── Web Push ────────────────────────────────────────────────────────────────
# [optional: all three or none] VAPID keys and contact (`mailto:` or `https:`).
# Unset switches push off; the alert and dashboard polls deliver either way.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com

# ── Attendance ──────────────────────────────────────────────────────────────
# [optional] Seed this account as ADMIN and use it as the event-day trust root.
# Set it before seeding. Production also needs SEED_ADMIN_SUB for the seed.
# ATTENDANCE_ROOT_EMAIL=event-root@example.com
# [optional] Dedicated attendance key, >= 32 chars; defaults to a key derived
# from SESSION_SIGNING_SECRET.
# ATTENDANCE_SIGNING_SECRET=replace-with-a-random-secret-at-least-32-characters
# [optional, default empty] Campus PUBLIC egress CIDRs from SP IT,
# comma-separated (IPv4 and/or IPv6). Empty means QR network verification fails
# closed; the secondary PIN remains usable.
ATTENDANCE_SP_CIDRS=

# ── Development convenience ─────────────────────────────────────────────────
# [optional, default false] Treat every hour as event hours, so the capture
# screens work outside 09:30-18:00 Singapore. Refused when NODE_ENV=production.
SHIFT_HOURS_ALWAYS_OPEN=true
