// ─────────────────────────────────────────────
// COMMS
// ─────────────────────────────────────────────

/// Private unpublished content; publication and durable delivery are separate operations.
/// @eventOwned
model AnnouncementDraft {
  id                 String               @id @default(cuid())
  eventId            String
  authorId           String
  authorMembershipId String
  /// @class operational
  body               String
  priority           AnnouncementPriority @default(INFO)
  targetRole         CommitteeRole?
  targetStationId    String?
  targetEventDayId   String?
  requiresAck        Boolean              @default(false)
  expiresAt          DateTime?            @db.Timestamptz(3)
  version            Int                  @default(1)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @default(now()) @db.Timestamptz(3)

  event            Event                    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  author           Person                   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorMembership EventMembership          @relation("AnnouncementDraftAuthorMembership", fields: [eventId, authorMembershipId], references: [eventId, id], onDelete: Restrict)
  targetStation    Station?                 @relation(fields: [eventId, targetStationId], references: [eventId, id], onDelete: Restrict)
  targetDay        EventDay?                @relation(fields: [eventId, targetEventDayId], references: [eventId, id], onDelete: Restrict)
  publication      AnnouncementPublication?

  @@unique([eventId, id])
  @@unique([eventId, id, version])
  @@index([eventId, authorId, updatedAt])
  @@index([authorMembershipId])
}

/// Immutable link from a saved private version to its published message and real scheduled action.
/// @eventOwned
model AnnouncementPublication {
  id                String   @id @default(cuid())
  eventId           String
  draftId           String
  version           Int
  announcementId    String
  scheduledActionId String
  publishedAt       DateTime @db.Timestamptz(3)

  event           Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  draft           AnnouncementDraft @relation(fields: [eventId, draftId, version], references: [eventId, id, version], onDelete: Restrict, onUpdate: Restrict)
  announcement    Announcement      @relation(fields: [eventId, announcementId], references: [eventId, id], onDelete: Restrict, onUpdate: Restrict)
  scheduledAction ScheduledAction   @relation(fields: [eventId, scheduledActionId], references: [eventId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([eventId, id])
  @@unique([eventId, draftId])
  @@unique([eventId, draftId, version])
  @@unique([eventId, announcementId])
  @@unique([eventId, scheduledActionId])
  @@index([eventId, publishedAt])
}

/// @eventOwned
model Announcement {
  id                 String               @id @default(cuid())
  /// The event this row belongs to (ADR-001 §2).
  eventId            String
  /// @class operational
  body               String
  priority           AnnouncementPriority @default(INFO)
  targetRole         CommitteeRole?
  targetStationId    String?
  targetEventDayId   String?
  requiresAck        Boolean              @default(false)
  authorId           String
  /// The EventMembership behind authorId (ADR-001); backfilled in P09.4, read from P09.5.
  authorMembershipId String?
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  expiresAt          DateTime?            @db.Timestamptz(3)

  author        Person                    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  targetStation Station?                  @relation(fields: [eventId, targetStationId], references: [eventId, id], onDelete: Cascade)
  targetDay     EventDay?                 @relation(fields: [eventId, targetEventDayId], references: [eventId, id], onDelete: Cascade)
  acks          AnnouncementAck[]
  deliveryPlan  AnnouncementDeliveryPlan?
  publication   AnnouncementPublication?

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  // Their memberships, inside the event (ADR-001 §2).
  authorMembership EventMembership? @relation("AnnouncementAuthorMembership", fields: [eventId, authorMembershipId], references: [eventId, id], onDelete: Restrict)

  @@unique([eventId, id])
  @@index([createdAt])
  @@index([eventId, createdAt])
  @@index([authorMembershipId])
}

/// @eventOwned
model AnnouncementAck {
  id             String   @id @default(cuid())
  /// The event this row belongs to (ADR-001 §2).
  eventId        String
  announcementId String
  volunteerId    String
  /// The EventMembership behind volunteerId (ADR-001); backfilled in P09.4, read from P09.5.
  membershipId   String?
  ackedAt        DateTime @default(now()) @db.Timestamptz(3)

  announcement Announcement @relation(fields: [eventId, announcementId], references: [eventId, id], onDelete: Cascade)
  volunteer    Person       @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  // Their memberships, inside the event (ADR-001 §2).
  membership EventMembership? @relation("AnnouncementAckMembership", fields: [eventId, membershipId], references: [eventId, id], onDelete: Restrict)

  @@unique([announcementId, volunteerId])
  @@index([eventId])
  @@index([membershipId])
}

/// One immutable audience/device snapshot, even when it contains no subscribed devices.
/// No message text, endpoint or push credential is copied here.
/// @eventOwned
model AnnouncementDeliveryPlan {
  id             String   @id @default(cuid())
  eventId        String
  announcementId String
  recipientCount Int
  deviceCount    Int
  createdAt      DateTime @db.Timestamptz(3)
  expiresAt      DateTime @db.Timestamptz(3)

  event        Event                      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  announcement Announcement               @relation(fields: [eventId, announcementId], references: [eventId, id], onDelete: Cascade)
  deliveries   AnnouncementPushDelivery[]

  @@unique([eventId, id])
  @@unique([eventId, announcementId])
  @@index([eventId, expiresAt])
}

enum AnnouncementPushDeliveryStatus {
  PENDING
  RUNNING
  SENT
  SKIPPED
  DEAD
}

enum AnnouncementPushDeliveryError {
  UNCONFIGURED
  RECIPIENT_INACTIVE
  SUBSCRIPTION_GONE
  SUBSCRIPTION_REASSIGNED
  EXPIRED
  ARCHIVED
  SOURCE_UNAVAILABLE
  SOURCE_CHANGED
  PUSH_FAILED
  RETRY_EXHAUSTED
}

/// Technical delivery state; the future worker rechecks source, membership and device ownership.
/// @eventOwned
model AnnouncementPushDelivery {
  id                    String                         @id @default(cuid())
  eventId               String
  planId                String
  recipientPersonId     String
  recipientMembershipId String
  subscriptionId        String?
  /// Opaque subscription identity retained for deduplication after unsubscribe deletes the FK.
  /// @class operational
  deviceKey             String
  status                AnnouncementPushDeliveryStatus @default(PENDING)
  attempts              Int                            @default(0)
  maxAttempts           Int                            @default(5)
  version               Int                            @default(0)
  runAt                 DateTime                       @db.Timestamptz(3)
  /// @class operational
  lockedBy              String?
  lockedUntil           DateTime?                      @db.Timestamptz(3)
  completedAt           DateTime?                      @db.Timestamptz(3)
  /// Fixed operational codes only; never raw exception text, endpoint or credential.
  lastError             AnnouncementPushDeliveryError?
  createdAt             DateTime                       @db.Timestamptz(3)

  event        Event                    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  plan         AnnouncementDeliveryPlan @relation(fields: [eventId, planId], references: [eventId, id], onDelete: Cascade)
  recipient    Person                   @relation(fields: [recipientPersonId], references: [id], onDelete: Restrict)
  membership   EventMembership          @relation("AnnouncementPushRecipientMembership", fields: [eventId, recipientMembershipId], references: [eventId, id], onDelete: Restrict)
  subscription PushSubscription?        @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([eventId, id])
  @@unique([planId, deviceKey])
  @@index([status, runAt])
  @@index([eventId, planId])
  @@index([recipientMembershipId])
  @@index([subscriptionId])
}

// ─────────────────────────────────────────────
// OPERATIONS / INTEGRITY
// ─────────────────────────────────────────────

/// A declared period of degraded operation. Reports covering an overlapping
/// range must say so plainly rather than silently blending sources (§11.4).
/// @eventOwned
model FallbackWindow {
  id                     String    @id @default(cuid())
  /// The event this row belongs to (ADR-001 §2).
  eventId                String
  /// Practice provenance is retained across imports and derived rows (ADR-004).
  rehearsal              Boolean   @default(false)
  /// 3 = google sheets, 4 = paper
  tier                   Int
  startedAt              DateTime  @db.Timestamptz(3)
  endedAt                DateTime? @db.Timestamptz(3)
  /// null = event-wide
  stationId              String?
  declaredById           String
  /// The EventMembership behind declaredById (ADR-001); backfilled in P09.4, read from P09.5.
  declaredByMembershipId String?
  /// @class operational
  reason                 String
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)

  declaredBy Person   @relation(fields: [declaredById], references: [id], onDelete: Restrict)
  station    Station? @relation(fields: [eventId, stationId], references: [eventId, id], onDelete: Restrict)

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  // Their memberships, inside the event (ADR-001 §2).
  declaredByMembership EventMembership? @relation("FallbackWindowDeclaredByMembership", fields: [eventId, declaredByMembershipId], references: [eventId, id], onDelete: Restrict)

  @@index([startedAt])
  // "Is a window open right now" is asked on every dashboard poll.
  @@index([endedAt])
  @@index([eventId, startedAt])
  @@index([declaredByMembershipId])
  @@index([eventId, rehearsal])
}

/// @eventOwned
model ImportBatch {
  id                     String     @id @default(cuid())
  /// The event this row belongs to (ADR-001 §2).
  eventId                String
  /// Practice provenance is retained across imports and derived rows (ADR-004).
  rehearsal              Boolean    @default(false)
  source                 DataSource
  /// @class operational
  targetTable            String
  rowCount               Int
  /// @class operational
  fileName               String?
  importedById           String
  /// The EventMembership behind importedById (ADR-001); backfilled in P09.4, read from P09.5.
  importedByMembershipId String?
  importedAt             DateTime   @default(now()) @db.Timestamptz(3)
  /// @class operational
  notes                  String?

  importedBy Person @relation(fields: [importedById], references: [id], onDelete: Restrict)

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  // Their memberships, inside the event (ADR-001 §2).
  importedByMembership EventMembership? @relation("ImportBatchImportedByMembership", fields: [eventId, importedByMembershipId], references: [eventId, id], onDelete: Restrict)

  @@index([importedAt])
  @@index([eventId])
  @@index([importedByMembershipId])
  @@index([eventId, rehearsal])
}

enum AuditSeverity {
  INFO
  NOTICE
  WARNING
  CRITICAL
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum AuditSource {
  USER
  SYSTEM
  SCHEDULE
}

enum ReportSnapshotKind {
  DAILY
  FINAL
}

/// The report document contains no allowlisted visitor values or lost-person descriptions.
/// @eventOwned
model ReportSnapshot {
  id                String             @id @default(cuid())
  eventId           String
  kind              ReportSnapshotKind
  lifecycleVersion  Int
  /// A final phase version, or the daily job's occurrence key.
  /// @class operational
  dedupeKey         String
  rehearsalIncluded Boolean            @default(false)
  /// Includes operational notes and staff names, with the report's existing access boundary.
  /// @class staff-personal
  report            Json
  createdByPersonId String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  supersededAt      DateTime?          @db.Timestamptz(3)

  event     Event   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  createdBy Person? @relation(fields: [createdByPersonId], references: [id], onDelete: Restrict)

  @@unique([eventId, id])
  @@unique([eventId, dedupeKey])
  @@index([eventId, kind, supersededAt])
}

enum ScheduledActionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
  CANCELLED
}

/// Platform queue; eventId is null only for platform maintenance actions (ADR-004 §4).
model ScheduledAction {
  id                String                @id @default(cuid())
  eventId           String?
  /// Handler catalogue key, validated before enqueueing and again at execution.
  /// @class operational
  type              String
  /// @class staff-personal
  payload           Json
  /// Original due instant, initialised on first claim; runAt then controls retry eligibility.
  scheduledFor      DateTime?             @db.Timestamptz(3)
  runAt             DateTime              @db.Timestamptz(3)
  status            ScheduledActionStatus @default(PENDING)
  attempts          Int                   @default(0)
  maxAttempts       Int                   @default(5)
  /// @class operational
  lastError         String?
  /// @class operational
  lockedBy          String?
  lockedUntil       DateTime?             @db.Timestamptz(3)
  /// Recurrence interval in seconds; null for one-off actions.
  recurrence        Int?
  /// System occurrence key, including its event scope; null for unscheduled deduplication.
  /// @class operational
  dedupeKey         String?               @unique
  version           Int                   @default(1)
  createdByPersonId String?
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  completedAt       DateTime?             @db.Timestamptz(3)

  event                    Event?                    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  createdBy                Person?                   @relation(fields: [createdByPersonId], references: [id], onDelete: Restrict)
  auditLogs                AuditLog[]
  settingChanges           SettingChange[]
  announcementPublications AnnouncementPublication[]

  @@unique([eventId, id])
  @@index([status, runAt])
  @@index([status, lockedUntil])
  @@index([eventId, runAt, id])
}

model AuditLog {
  id                String        @id @default(cuid())
  /// The event, when the row was written inside one; null for platform actions (ADR-001 §3).
  eventId           String?
  actorId           String?
  /// The EventMembership behind actorId (ADR-001); backfilled in P09.4, read from P09.5.
  membershipId      String?
  /// @class staff-personal
  actorSub          String?
  /// "registration.void", "card.reissue", "auth.signInFailed"
  /// @class operational
  action            String
  severity          AuditSeverity @default(INFO)
  outcome           AuditOutcome  @default(SUCCESS)
  source            AuditSource   @default(USER)
  scheduledActionId String?
  /// @class operational
  entityType        String
  entityId          String?
  /// @class staff-personal
  before            Json?
  /// @class staff-personal
  after             Json?
  /// Transport detail. Set on security events, null on change events, which
  /// describe themselves through before/after instead.
  /// @class operational
  method            String?
  /// @class operational
  path              String?
  statusCode        Int?
  /// @class staff-personal
  ip                String?
  /// @class staff-personal
  userAgent         String?
  requestId         String?
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)

  actor Person? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  event           Event?           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  scheduledAction ScheduledAction? @relation(fields: [scheduledActionId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  // The security screen's default view: everything that was refused, newest
  // first. Without this it is a sequential scan of the busiest table we have.
  @@index([severity, createdAt])
  @@index([outcome, createdAt])
  // Tailing. The live view asks for "rows after this id" every few seconds.
  @@index([id, createdAt])
  @@index([eventId, createdAt])
  @@index([membershipId])
  @@index([scheduledActionId])
}

/// Makes the client's retry-on-failure loop safe, which is what makes the local
/// write buffer possible without duplicate counts (BUILD_PLAN §7.4).
model IdempotencyRecord {
  /// @class operational
  key          String   @id
  /// The event, when the row was written inside one; null for platform actions (ADR-001 §3).
  eventId      String?
  /// @class operational
  endpoint     String
  /// @class staff-personal
  actorSub     String
  /// @class staff-personal
  responseBody Json
  statusCode   Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  event Event? @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([eventId])
}

/// A visitor field an event declares in allowlist mode (ADR-002 §4): what may
/// be collected, how long it is kept after the event closes, and who reads it.
/// @eventOwned
model VisitorField {
  id             String          @id @default(cuid())
  /// The event this row belongs to (ADR-001 §2).
  eventId        String
  /// @class operational
  code           String
  /// @class operational
  label          String
  /// text, email, phone or number.
  /// @class operational
  type           String
  /// visitor-personal, or operational for a field that identifies nobody.
  /// @class operational
  classification String
  retentionDays  Int
  readers        CommitteeRole[]
  sortOrder      Int             @default(0)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([eventId, code])
  @@unique([eventId, id])
}

/// One registration's declared visitor values, kept apart from every count:
/// a purge deletes these and leaves the counts untouched (ADR-002 §4).
/// @eventOwned
model VisitorRecord {
  id             String    @id @default(cuid())
  /// The event this row belongs to (ADR-001 §2).
  eventId        String
  /// Copied from its registration, including when older writers omit the field.
  rehearsal      Boolean
  registrationId String    @unique
  /// Values by field code, each checked against the event's fields.
  /// @class visitor-personal
  data           Json
  /// Deadline for the last remaining value, set when the event closes.
  purgeAfter     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration Registration @relation(fields: [eventId, registrationId, rehearsal], references: [eventId, id, rehearsal], onDelete: Restrict, onUpdate: Restrict)

  @@unique([eventId, registrationId])
  @@unique([eventId, registrationId, rehearsal])
  @@index([eventId, createdAt])
  @@index([eventId, purgeAfter])
  @@index([eventId, rehearsal])
}

enum SettingScope {
  PLATFORM
  EVENT
  STATION
}

enum SettingChangeSource {
  USER
  SCHEDULE
  REVERT
  RESET
  CLONE
  MIGRATION
}

/// A stored setting at one scope (ADR-003 §2): the organisation (platform), an
/// event, or a station. Resolution is station, event, platform, then the
/// compiled default. An event or station row carries its eventId.
model Setting {
  id                String       @id @default(cuid())
  scope             SettingScope
  /// The organisation, event or station the value applies to.
  scopeId           String
  eventId           String?
  /// @class operational
  key               String
  /// @class operational
  value             Json
  /// 1 on the first write; a change names the version it read.
  version           Int
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)
  updatedByPersonId String?

  event     Event?  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  updatedBy Person? @relation("SettingUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)

  @@unique([scope, scopeId, key])
  @@index([eventId])
}

/// Every version a setting has had, append-only (ADR-003 §2).
model SettingChange {
  id                String              @id @default(cuid())
  scope             SettingScope
  scopeId           String
  eventId           String?
  /// @class operational
  key               String
  version           Int
  /// @class operational
  before            Json?
  /// @class operational
  after             Json?
  /// @class operational
  reason            String?
  source            SettingChangeSource
  actorPersonId     String?
  /// Set when a scheduled action applies the change (P10.6).
  scheduledActionId String?
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)

  event           Event?           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  actor           Person?          @relation("SettingChangedBy", fields: [actorPersonId], references: [id], onDelete: SetNull)
  scheduledAction ScheduledAction? @relation(fields: [scheduledActionId], references: [id], onDelete: Restrict)

  @@index([scope, scopeId, key, version])
  @@index([eventId])
}

/// Runtime configuration (see server/src/platform/settings/index.ts).
///
/// Shift block times, silence thresholds, the implausible-tap rate and the
/// retention windows were constants compiled into the server. Every one of them
/// is a number somebody wants to change during a dry run without a redeploy, so
/// they live here instead: a typed key, a JSON value, and the volunteer who
/// last changed it. Unknown or unset keys fall back to the compiled defaults,
/// so an empty table is a working system.
model AppSetting {
  /// @class operational
  key         String   @id
  /// @class operational
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  updatedBy Person? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

/// A browser push endpoint (RFC 8030 / Web Push).
///
/// One row per device per volunteer, keyed on the endpoint URL because that is
/// what the push service considers unique. failureCount lets a subscription
/// that has started refusing deliveries be dropped before it wastes a send on
/// every urgent broadcast; a 404 or 410 from the push service deletes it
/// outright, which is the documented way a subscription expires.
model PushSubscription {
  id           String   @id @default(cuid())
  volunteerId  String
  /// @class staff-personal
  endpoint     String   @unique
  /// @class credential
  p256dh       String
  /// @class credential
  auth         String
  /// @class staff-personal
  userAgent    String?
  failureCount Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt   DateTime @default(now()) @db.Timestamptz(3)

  volunteer Person @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  announcementDeliveries AnnouncementPushDelivery[]

  @@index([volunteerId])
}

/// A refresh-token family member.
///
/// The access token is short-lived and held in memory by the client; this is
/// what lets a hard refresh recover the session without putting a long-lived
/// credential in localStorage. Only the SHA-256 of the token is stored, so the
/// table is useless to anybody who reads it.
///
/// familyId implements reuse detection: rotation issues a new row in the same
/// family and revokes the old one, so presenting an already-rotated token means
/// the cookie leaked and the entire family is revoked at once.
model RefreshSession {
  id            String    @id @default(cuid())
  volunteerId   String
  /// SHA-256 hex of the opaque token. Never the token itself.
  /// @class credential
  tokenHash     String    @unique
  familyId      String
  /// @class staff-personal
  userAgent     String?
  /// @class staff-personal
  ip            String?
  issuedAt      DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  lastUsedAt    DateTime? @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  /// Why it was revoked: "rotated", "signed-out", "reuse-detected", "deactivated".
  /// @class operational
  revokedReason String?

  volunteer Person @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([volunteerId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}
