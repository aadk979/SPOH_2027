/// A declared period of degraded operation. Reports covering an overlapping
/// range must say so plainly rather than silently blending sources (§11.4).
/// @eventOwned
model FallbackWindow {
  id                     String    @id @default(cuid())
  /// The event this row belongs to (ADR-001 §2). Nullable until P09.10 backfills and contracts.
  eventId                String?
  /// 3 = google sheets, 4 = paper
  tier                   Int
  startedAt              DateTime  @db.Timestamptz(3)
  endedAt                DateTime? @db.Timestamptz(3)
  /// null = event-wide
  stationId              String?
  declaredById           String
  /// The EventMembership behind declaredById (ADR-001); backfilled in P09.4, read from P09.5.
  declaredByMembershipId String?
  reason                 String
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)

  declaredBy Person   @relation(fields: [declaredById], references: [id], onDelete: Restrict)
  station    Station? @relation(fields: [stationId], references: [id], onDelete: Restrict)

  event Event? @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([startedAt])
  // "Is a window open right now" is asked on every dashboard poll.
  @@index([endedAt])
  @@index([eventId, startedAt])
  @@index([declaredByMembershipId])
}

