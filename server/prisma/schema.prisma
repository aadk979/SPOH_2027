// SPOH 2027 Event Operations System — data model.
// Transcribed from BUILD_PLAN §5. Extend only with approval.
//
// Two rules are enforced by the shape of this file rather than by convention:
//
//  1. THE THREE COUNTS NEVER MERGE (PRODUCT_BRIEF §0.1). `Registration`,
//     `FootfallTick` and `MissionCard`/`CardStampEvent` are separate tables with
//     no foreign key joining registration to footfall, and there is no
//     `totalVisitors` column anywhere. One Mission Card can be four humans.
//
//  2. NO VISITOR PERSONAL DATA (PRODUCT_BRIEF §0.2). No visitor-scoped model
//     carries a name, contact detail, school or identifier. `LostPersonAlert` is
//     the single exception and is purged to `LostPersonSummary` after
//     resolution. A CI test asserts this — see server/tests/unit/noPii.test.ts.
//
//  3. EVERY FOREIGN KEY IS A REAL FOREIGN KEY. No column holds an id by
//     convention alone. A dangling actor on a stock adjustment or a fallback
//     declaration is precisely the row that matters during reconciliation, and
//     "it is always populated in practice" is not a constraint.
//
// Referential actions are chosen per relation rather than left to the default:
// Restrict where deleting the parent would orphan operational history, Cascade
// only where the child is meaningless without its parent (an acknowledgement, a
// push subscription, a refresh session). AuditLog.actorId is the one SetNull —
// the audit trail must outlive the roster it describes, and actorSub is kept so
// a removed volunteer's actions stay attributable.

// Prisma 7 moves the connection URL out of the schema: Migrate reads it from
// `prisma.config.ts`, and the runtime client receives a driver adapter instead
// (see src/platform/db/client.ts). Nothing about the data model changes.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum CommitteeRole {
  VOLUNTEER
  IC
  DEPUTY_COORDINATOR
  CHIEF_COORDINATOR
  LEAD
  ADMIN
}

/// Provenance of a captured row. Reports must never silently blend sources.
/// Why a redemption synced from the offline queue needs an IC's attention.
enum RedemptionFlag {
  OVER_STOCK
  SECOND_GIFT
}

enum DataSource {
  APP
  FALLBACK_SHEET
  PAPER
  MANUAL_ADJUSTMENT
}

enum SwapStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum IncidentType {
  INJURY
  ILLNESS
  NEAR_MISS
  SAFETY_CONCERN
  CROWD_CONCERN
  EQUIPMENT
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum LostPersonStatus {
  ACTIVE
  RESOLVED_FOUND
  RESOLVED_OTHER
}

enum LostFoundStatus {
  HELD
  CLAIMED
  UNCLAIMED_AT_CLOSE
  DISPOSED
}

enum CardStatus {
  UNISSUED
  ISSUED
  COMPLETED
  VOIDED
  LOST
}

enum AnnouncementPriority {
  INFO
  OPERATIONAL
  URGENT
}

// ─────────────────────────────────────────────
// REFERENCE / CONFIG
// ─────────────────────────────────────────────

/// Organisation-level access (ADR-001 §1): platform admins create, clone and
/// archive events and alone edit guardrails (ADR-005).
enum OrganisationRole {
  MEMBER
  PLATFORM_ADMIN
}

/// A person's standing in one event (ADR-001 §1).
enum MembershipStatus {
  INVITED
  ACTIVE
  DEACTIVATED
  ENDED
}

model OrganisationMembership {
  id             String           @id @default(cuid())
  organisationId String
  personId       String
  role           OrganisationRole @default(MEMBER)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@unique([organisationId, personId])
}

/// A person working in one event: the role half of what Volunteer was
/// (ADR-001 §1). Unique per (event, person).
/// @eventOwned
model EventMembership {
  id                String           @id @default(cuid())
  eventId           String
  personId          String
  role              CommitteeRole    @default(VOLUNTEER)
  /// @class operational
  portfolio         String?
  /// Another membership of the same event.
  reportsToId       String?
  status            MembershipStatus @default(ACTIVE)
  invitedAt         DateTime?        @db.Timestamptz(3)
  acceptedAt        DateTime?        @db.Timestamptz(3)
  deactivatedAt     DateTime?        @db.Timestamptz(3)
  /// @class staff-personal
  deactivatedReason String?
  lastSeenAt        DateTime?        @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  event         Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  person        Person            @relation(fields: [personId], references: [id], onDelete: Restrict)
  reportsTo     EventMembership?  @relation("MembershipHierarchy", fields: [eventId, reportsToId], references: [eventId, id], onDelete: Restrict)
  directReports EventMembership[] @relation("MembershipHierarchy")

  // Every row that names this membership, each inside the event.
  importBatchImportedByMembership        ImportBatch[]              @relation("ImportBatchImportedByMembership")
  fallbackWindowDeclaredByMembership     FallbackWindow[]           @relation("FallbackWindowDeclaredByMembership")
  announcementAckMembership              AnnouncementAck[]          @relation("AnnouncementAckMembership")
  announcementAuthorMembership           Announcement[]             @relation("AnnouncementAuthorMembership")
  announcementDraftAuthorMembership      AnnouncementDraft[]        @relation("AnnouncementDraftAuthorMembership")
  announcementPushRecipientMembership    AnnouncementPushDelivery[] @relation("AnnouncementPushRecipientMembership")
  lostFoundItemLoggedByMembership        LostFoundItem[]            @relation("LostFoundItemLoggedByMembership")
  lostPersonAckMembership                LostPersonAck[]            @relation("LostPersonAckMembership")
  lostPersonAlertRaisedByMembership      LostPersonAlert[]          @relation("LostPersonAlertRaisedByMembership")
  incidentFollowUpAuthorMembership       IncidentFollowUp[]         @relation("IncidentFollowUpAuthorMembership")
  incidentReportedByMembership           Incident[]                 @relation("IncidentReportedByMembership")
  giftStockAdjustmentCreatedByMembership GiftStockAdjustment[]      @relation("GiftStockAdjustmentCreatedByMembership")
  giftRedemptionRecordedByMembership     GiftRedemption[]           @relation("GiftRedemptionRecordedByMembership")
  cardStampEventRecordedByMembership     CardStampEvent[]           @relation("CardStampEventRecordedByMembership")
  footfallTickRecordedByMembership       FootfallTick[]             @relation("FootfallTickRecordedByMembership")
  registrationRecordedByMembership       Registration[]             @relation("RegistrationRecordedByMembership")
  briefingSlotBriefierMembership         BriefingSlot[]             @relation("BriefingSlotBriefierMembership")
  shiftSwapRequestRequesterMembership    ShiftSwapRequest[]         @relation("ShiftSwapRequestRequesterMembership")
  shiftSwapRequestTargetMembership       ShiftSwapRequest[]         @relation("ShiftSwapRequestTargetMembership")
  shiftSwapRequestDecidedByMembership    ShiftSwapRequest[]         @relation("ShiftSwapRequestDecidedByMembership")
  attendanceAttemptMembership            AttendanceAttempt[]        @relation("AttendanceAttemptMembership")
  attendanceChallengeIssuerMembership    AttendanceChallenge[]      @relation("AttendanceChallengeIssuerMembership")
  attendanceMembership                   Attendance[]               @relation("AttendanceMembership")
  attendanceVerifiedByMembership         Attendance[]               @relation("AttendanceVerifiedByMembership")
  shiftAssignmentMembership              ShiftAssignment[]          @relation("ShiftAssignmentMembership")

  @@unique([eventId, personId])
  @@unique([eventId, id])
  @@index([eventId, role, status])
}

/// The eventual multi-event owner (D-02 A): one row today, so multi-organisation
/// (D-02 B) stays a data change (ADR-001 §1).
model Organisation {
  id              String   @id @default(cuid())
  /// @class operational
  slug            String   @unique
  /// @class operational
  name            String
  /// @class operational
  appName         String
  /// @class operational
  locale          String   @default("en-SG")
  /// @class operational
  defaultTimezone String
  /// @class operational
  branding        Json?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  events      Event[]
  memberships OrganisationMembership[]
}

/// The event lifecycle (ADR-004 §1).
enum EventStatus {
  DRAFT
  READY
  REHEARSAL
  LIVE
  CLOSED
  ARCHIVED
}

/// One event (ADR-001 §1). Its dates are its EventDay rows, never stored here,
/// so they cannot disagree.
model Event {
  id                 String      @id @default(cuid())
  organisationId     String
  /// @class operational
  slug               String
  /// @class operational
  name               String
  /// @class operational
  venue              String?
  /// IANA timezone every wall-clock time of the event is read in (ADR-007 §7).
  /// @class operational
  timezone           String
  /// @class operational
  locale             String      @default("en-SG")
  status             EventStatus @default(DRAFT)
  /// Monotonic preparation history, maintained for older writers too.
  hasBeenLive        Boolean     @default(false)
  lifecycleVersion   Int         @default(0)
  /// Minutes after local midnight at which "today" starts (ADR-004 §3).
  dayBoundaryMinutes Int         @default(0)
  /// @class operational
  branding           Json?
  clonedFromEventId  String?
  /// When the event closed: visitor data retention counts from it (ADR-002 §4).
  /// Set by the lifecycle (ADR-004).
  closedAt           DateTime?   @db.Timestamptz(3)
  archivedAt         DateTime?   @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(3)

  organisation               Organisation               @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  clonedFrom                 Event?                     @relation("EventClone", fields: [clonedFromEventId], references: [id], onDelete: Restrict)
  clones                     Event[]                    @relation("EventClone")
  memberships                EventMembership[]
  settings                   Setting[]
  visitorFields              VisitorField[]
  visitorRecords             VisitorRecord[]
  settingChanges             SettingChange[]
  captureCategories          CaptureCategory[]
  stationTypes               StationType[]
  stationTags                StationTag[]
  stationTaggings            StationTagging[]
  shiftTemplates             ShiftTemplate[]
  shifts                     Shift[]
  days                       EventDay[]
  stations                   Station[]
  shiftAssignments           ShiftAssignment[]
  attendances                Attendance[]
  attendanceChallenges       AttendanceChallenge[]
  attendanceAttempts         AttendanceAttempt[]
  shiftSwapRequests          ShiftSwapRequest[]
  briefingSlots              BriefingSlot[]
  registrations              Registration[]
  footfallTicks              FootfallTick[]
  missionCards               MissionCard[]
  cardStampEvents            CardStampEvent[]
  giftTypes                  GiftType[]
  giftRedemptions            GiftRedemption[]
  giftStockAdjustments       GiftStockAdjustment[]
  incidents                  Incident[]
  incidentFollowUps          IncidentFollowUp[]
  lostPersonAlerts           LostPersonAlert[]
  lostPersonAcks             LostPersonAck[]
  lostPersonSummaries        LostPersonSummary[]
  lostFoundItems             LostFoundItem[]
  announcements              Announcement[]
  announcementDrafts         AnnouncementDraft[]
  announcementAcks           AnnouncementAck[]
  announcementDeliveryPlans  AnnouncementDeliveryPlan[]
  announcementPublications   AnnouncementPublication[]
  announcementPushDeliveries AnnouncementPushDelivery[]
  fallbackWindows            FallbackWindow[]
  importBatches              ImportBatch[]
  auditLogs                  AuditLog[]
  idempotencyRecords         IdempotencyRecord[]
  reportSnapshots            ReportSnapshot[]
  scheduledActions           ScheduledAction[]

  @@unique([organisationId, slug])
  @@index([status])
}

// --- Taxonomy (ADR-002 §1): what an event counts, where and when, as data ---

/// A category a registration counts in; replaces VisitorCategory.
/// @eventOwned
model CaptureCategory {
  id        String   @id @default(cuid())
  eventId   String
  /// Stable: CSV imports and content refer to it. The label is free.
  /// @class operational
  code      String
  /// @class operational
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registrations Registration[]

  @@unique([eventId, code])
  @@unique([eventId, id])
  @@index([eventId, active, sortOrder])
}

/// What kind of station, and so what it may do; replaces StationKind and the
/// per-station countsEntry/issuesStamp flags. Capabilities live here only.
/// @eventOwned
model StationType {
  id                String   @id @default(cuid())
  eventId           String
  /// @class operational
  code              String
  /// @class operational
  label             String
  registersVisitors Boolean  @default(false)
  countsEntry       Boolean  @default(false)
  issuesStamp       Boolean  @default(false)
  redeemsGifts      Boolean  @default(false)
  sortOrder         Int      @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  stations Station[]

  @@unique([eventId, code])
  @@unique([eventId, id])
}

/// A label a station can carry (a course is one kind); replaces CourseCode.
/// @eventOwned
model StationTag {
  id          String   @id @default(cuid())
  eventId     String
  /// @class operational
  code        String
  /// @class operational
  label       String
  /// @class operational
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  event    Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  stations StationTagging[]

  @@unique([eventId, code])
  @@unique([eventId, id])
}

/// @eventOwned
model StationTagging {
  eventId   String
  stationId String
  tagId     String

  event   Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  station Station    @relation(fields: [eventId, stationId], references: [eventId, id], onDelete: Cascade)
  tag     StationTag @relation(fields: [eventId, tagId], references: [eventId, id], onDelete: Restrict)

  @@id([stationId, tagId])
  @@index([eventId, tagId])
}

/// A shift pattern in the event's local time (ADR-002). endsNextDay lets a
/// shift cross midnight.
/// @eventOwned
model ShiftTemplate {
  id          String   @id @default(cuid())
  eventId     String
  /// @class operational
  code        String
  /// @class operational
  label       String
  /// HH:MM on the event's wall clock.
  /// @class operational
  startLocal  String
  /// @class operational
  endLocal    String
  endsNextDay Boolean  @default(false)
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  shifts Shift[]

  @@unique([eventId, code])
  @@unique([eventId, id])
}

/// A template on a day, as real instants: running now means startsAt <= now < endsAt.
/// @eventOwned
model Shift {
  id         String   @id @default(cuid())
  eventId    String
  eventDayId String
  templateId String
  startsAt   DateTime @db.Timestamptz(3)
  endsAt     DateTime @db.Timestamptz(3)
  /// Set by the exceptions grid; a template edit leaves an overridden shift alone.
  overridden Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  eventDay    EventDay          @relation(fields: [eventId, eventDayId], references: [eventId, id], onDelete: Restrict)
  template    ShiftTemplate     @relation(fields: [eventId, templateId], references: [eventId, id], onDelete: Restrict)
  assignments ShiftAssignment[]

  @@unique([eventDayId, templateId])
  @@unique([eventId, id])
  @@index([eventId, startsAt, endsAt])
}

/// @eventOwned
model EventDay {
  id          String   @id @default(cuid())
  /// The event this row belongs to (ADR-001 §2).
  eventId     String
  date        DateTime @db.Date
  /// "Sec 4 Tour Day 1", "Open House Day 2"
  /// @class operational
  label       String
  isPublicDay Boolean  @default(true)
  isTourDay   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  shiftAssignments     ShiftAssignment[]
  briefingSlots        BriefingSlot[]
  announcements        Announcement[]
  announcementDrafts   AnnouncementDraft[]
  attendance           Attendance[]
  attendanceChallenges AttendanceChallenge[]

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  shifts Shift[]

  /// One day per date in each event; two events may share a date (P09.9).
  @@unique([eventId, date])
  @@unique([eventId, id])
  @@index([eventId, date])
}

/// @eventOwned
model Station {
  id        String  @id @default(cuid())
  /// The event this row belongs to (ADR-001 §2).
  eventId   String
  /// What happens at the station: its type's capability flags (ADR-002).
  typeId    String
  /// "DAAA_STATION", "SIGNUP_BOOTH"
  /// @class operational
  code      String
  /// @class operational
  name      String
  /// @class operational
  floor     String?
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  registrations      Registration[]
  footfallTicks      FootfallTick[]
  stampEvents        CardStampEvent[]
  shiftAssignments   ShiftAssignment[]
  incidents          Incident[]
  redemptions        GiftRedemption[]
  lostFoundItems     LostFoundItem[]
  announcements      Announcement[]
  announcementDrafts AnnouncementDraft[]
  fallbackWindows    FallbackWindow[]

  event Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  type  StationType      @relation(fields: [eventId, typeId], references: [eventId, id], onDelete: Restrict)
  tags  StationTagging[]

  /// Codes are unique within an event, so a clone keeps them (P09.9).
  lostPersonsLastSeen LostPersonAlert[] @relation("LostPersonLastSeen")

  @@unique([eventId, code])
  @@unique([eventId, id])
  @@index([eventId, typeId, active])
}

// ─────────────────────────────────────────────
// PEOPLE (committee only — never visitors)
// ─────────────────────────────────────────────

model Person {
  id          String    @id @default(cuid())
  /// @class staff-personal
  cognitoSub  String    @unique
  /// @class staff-personal
  displayName String
  /// @class staff-personal
  email       String    @unique
  /// @class staff-personal
  phone       String?
  /// Last authenticated request. Lets an admin see who has actually signed in
  /// before the event, rather than discovering it at 09:25 on the day.
  lastSeenAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  attendance           Attendance[]          @relation("Attendee")
  verifiedAttendance   Attendance[]          @relation("AttendanceVerifier")
  attendanceChallenges AttendanceChallenge[]
  attendanceAttempt    AttendanceAttempt?

  shiftAssignments   ShiftAssignment[]
  registrations      Registration[]
  footfallTicks      FootfallTick[]
  stampEvents        CardStampEvent[]
  redemptions        GiftRedemption[]
  incidentsRaised    Incident[]          @relation("IncidentReporter")
  lostPersonAlerts   LostPersonAlert[]
  lostFoundItems     LostFoundItem[]
  announcements      Announcement[]
  announcementDrafts AnnouncementDraft[]
  auditLogs          AuditLog[]
  swapsRequested     ShiftSwapRequest[]  @relation("SwapRequester")
  swapsTargeted      ShiftSwapRequest[]  @relation("SwapTarget")
  swapsDecided       ShiftSwapRequest[]  @relation("SwapDecider")
  briefingSlots      BriefingSlot[]

  // Back-relations for the foreign keys that used to be scalars by convention.
  giftAdjustments            GiftStockAdjustment[]
  incidentFollowUps          IncidentFollowUp[]
  lostPersonAcks             LostPersonAck[]
  announcementAcks           AnnouncementAck[]
  fallbackWindows            FallbackWindow[]
  importBatches              ImportBatch[]
  settingsChanged            AppSetting[]
  settingsUpdated            Setting[]                  @relation("SettingUpdatedBy")
  settingChanges             SettingChange[]            @relation("SettingChangedBy")
  pushSubscriptions          PushSubscription[]
  announcementPushDeliveries AnnouncementPushDelivery[]
  refreshSessions            RefreshSession[]
  reportSnapshots            ReportSnapshot[]
  scheduledActions           ScheduledAction[]

  eventMemberships        EventMembership[]
  organisationMemberships OrganisationMembership[]

  // The roster screen lists by name.
  @@index([displayName])
}

/// @eventOwned
model ShiftAssignment {
  id           String    @id @default(cuid())
  /// The event this row belongs to (ADR-001 §2).
  eventId      String
  /// The materialised shift (ADR-002): its day and template.
  shiftId      String
  volunteerId  String
  /// The EventMembership behind volunteerId (ADR-001); backfilled in P09.4, read from P09.5.
  membershipId String?
  stationId    String
  eventDayId   String
  /// "Usher", "Counter", "Lead Facilitator"
  /// @class operational
  roleLabel    String
  checkedInAt  DateTime? @db.Timestamptz(3)
  checkedOutAt DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  volunteer    Person             @relation(fields: [volunteerId], references: [id])
  station      Station            @relation(fields: [eventId, stationId], references: [eventId, id], onDelete: Restrict)
  eventDay     EventDay           @relation(fields: [eventId, eventDayId], references: [eventId, id], onDelete: Restrict)
  swapRequests ShiftSwapRequest[]

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  shift Shift @relation(fields: [eventId, shiftId], references: [eventId, id], onDelete: Restrict)

  // Their memberships, inside the event (ADR-001 §2).
  membership EventMembership? @relation("ShiftAssignmentMembership", fields: [eventId, membershipId], references: [eventId, id], onDelete: Restrict)

  /// One person cannot be on the same shift twice.
  @@unique([volunteerId, shiftId])
  @@unique([eventId, id])
  @@index([stationId, shiftId])
  @@index([eventId, stationId])
  @@index([shiftId])
  @@index([membershipId])
}

enum AttendanceMethod {
  ROOT
  QR
  PIN
}

/// @eventOwned
model Attendance {
  id                     String           @id @default(cuid())
  /// The event this row belongs to (ADR-001 §2).
  eventId                String
  /// Practice provenance is retained across imports and derived rows (ADR-004).
  rehearsal              Boolean          @default(false)
  volunteerId            String
  /// The EventMembership behind volunteerId (ADR-001); backfilled in P09.4, read from P09.5.
  membershipId           String?
  eventDayId             String
  verifiedById           String?
  /// The EventMembership behind verifiedById (ADR-001); backfilled in P09.4, read from P09.5.
  verifiedByMembershipId String?
  method                 AttendanceMethod
  presentAt              DateTime         @default(now()) @db.Timestamptz(3)
  volunteer              Person           @relation("Attendee", fields: [volunteerId], references: [id], onDelete: Restrict)
  verifiedBy             Person?          @relation("AttendanceVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  eventDay               EventDay         @relation(fields: [eventId, eventDayId], references: [eventId, id], onDelete: Restrict)

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  // Their memberships, inside the event (ADR-001 §2).
  membership           EventMembership? @relation("AttendanceMembership", fields: [eventId, membershipId], references: [eventId, id], onDelete: Restrict)
  verifiedByMembership EventMembership? @relation("AttendanceVerifiedByMembership", fields: [eventId, verifiedByMembershipId], references: [eventId, id], onDelete: Restrict)

  @@unique([volunteerId, eventDayId, rehearsal], name: "volunteerId_eventDayId")
  @@index([eventDayId, presentAt])
  @@index([eventId, eventDayId])
  @@index([membershipId])
  @@index([verifiedByMembershipId])
  @@index([eventId, rehearsal])
}

/// @eventOwned
model AttendanceChallenge {
  id                 String   @id
  /// The event this row belongs to (ADR-001 §2).
  eventId            String
  /// Practice provenance is retained across imports and derived rows (ADR-004).
  rehearsal          Boolean  @default(false)
  issuerId           String
  /// The EventMembership behind issuerId (ADR-001); backfilled in P09.4, read from P09.5.
  issuerMembershipId String?
  eventDayId         String
  /// @class credential
  pinHash            String   @unique
  campusNetwork      Boolean
  expiresAt          DateTime @db.Timestamptz(3)
