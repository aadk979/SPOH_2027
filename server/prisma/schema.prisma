/// @eventOwned
model Registration {
  id                     String     @id @default(cuid())
  /// The event this row belongs to (ADR-001 §2).
  eventId                String
  /// Practice provenance is retained across imports and derived rows (ADR-004).
  rehearsal              Boolean    @default(false)
  /// The event's capture category (ADR-002): the only record of what was counted (P09.10).
  categoryId             String
  stationId              String
  recordedById           String
  /// The EventMembership behind recordedById (ADR-001); backfilled in P09.4, read from P09.5.
  recordedByMembershipId String?
  /// Links members of one family/group. One group may share one Mission Card.
  groupId                String?
  /// Optional by design: a failed card link must never block the count.
  missionCardId          String?
  source                 DataSource @default(APP)
  recordedAt             DateTime   @default(now()) @db.Timestamptz(3)
  clientRecordedAt       DateTime?  @db.Timestamptz(3)
  idempotencyKey         String     @unique
  voided                 Boolean    @default(false)
  /// @class operational
  voidedReason           String?

  station     Station      @relation(fields: [eventId, stationId], references: [eventId, id], onDelete: Restrict)
  recordedBy  Person       @relation(fields: [recordedById], references: [id])
  missionCard MissionCard? @relation(fields: [eventId, missionCardId], references: [eventId, id], onDelete: Restrict)

  event           Event           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  captureCategory CaptureCategory @relation(fields: [eventId, categoryId], references: [eventId, id], onDelete: Restrict)

  // Their memberships, inside the event (ADR-001 §2).
  recordedByMembership EventMembership? @relation("RegistrationRecordedByMembership", fields: [eventId, recordedByMembershipId], references: [eventId, id], onDelete: Restrict)

  visitorRecord VisitorRecord?

  @@unique([eventId, id])
  @@unique([eventId, id, rehearsal])
  @@index([recordedAt])
  @@index([groupId])
  @@index([eventId, recordedAt])
  @@index([eventId, categoryId, recordedAt])
  @@index([recordedByMembershipId])
  @@index([eventId, rehearsal])
}

