{
  "name": "@spoh/server",
  "version": "0.1.0",
  "private": true,
  "description": "SPOH 2027 operations API — Express + Prisma + Postgres.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "build:seed": "tsc -p tsconfig.seed.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.seed.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:test:setup": "node scripts/setup-test-db.mjs",
    "pretest:integration": "npm run db:test:setup",
    "load-test": "node scripts/load-test.mjs",
    "verify:cognito": "node scripts/verify-cognito.mjs",
    "cognito:sync-subs": "node scripts/sync-cognito-subs.mjs",
    "cognito:recover": "node scripts/recover-identities.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1149.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1149.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1123.0",
    "@aws-sdk/client-rds": "^3.1149.0",
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/client-verifiedpermissions": "^3.1123.0",
    "@aws-sdk/s3-presigned-post": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "@cedar-policy/cedar-wasm": "4.13.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@spoh/access-policies": "*",
    "@spoh/shared": "*",
    "aws-jwt-verify": "^5.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.0",
    "jszip": "3.10.2",
    "parse5": "8.0.1",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "7.10.0",
    "qrcode": "1.5.4",
    "regenerator-runtime": "0.14.1",
    "sharp": "0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
